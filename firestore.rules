rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return signedIn() && (
        email() == 'leens@nsworld.net'
        || (activeAccess() && get(accessPath()).data.role == 'admin')
      );
    }

    function isTeacher() {
      return signedIn()
        && email().matches('.*@nsworld[.]net$')
        && activeAccess();
    }

    function accessPath() {
      return /databases/$(database)/documents/access/$(email());
    }

    function isRegisteredAccount() {
      return signedIn() && (
        email() == 'leens@nsworld.net'
        || activeAccess()
      );
    }

    function paddedDatePart(value) {
      return value < 10 ? '0' + string(value) : string(value);
    }

    function currentKoreaDate() {
      let koreaNow = request.time + duration.value(9, 'h');
      let date = koreaNow.date();
      return string(date.year()) + '-'
        + paddedDatePart(date.month()) + '-'
        + paddedDatePart(date.day());
    }

    function validEmploymentDate(value) {
      return value is string && value.matches(
        '^([0-9]{4}-(01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])'
        + '|[0-9]{4}-(04|06|09|11)-(0[1-9]|[12][0-9]|30)'
        + '|[0-9]{4}-02-(0[1-9]|1[0-9]|2[0-8])'
        + '|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)$'
      );
    }

    function validEmploymentPeriod(data) {
      let hasStart = data.keys().hasAny(['employmentStartDate']);
      let hasEnd = data.keys().hasAny(['employmentEndDate']);
      let start = hasStart ? data.employmentStartDate : '';
      let end = hasEnd ? data.employmentEndDate : '';
      return (!hasStart || validEmploymentDate(start))
        && (!hasEnd || validEmploymentDate(end))
        && (!(hasStart && hasEnd) || start <= end);
    }

    function employmentPeriodIsActive(data) {
      let hasStart = data.keys().hasAny(['employmentStartDate']);
      let hasEnd = data.keys().hasAny(['employmentEndDate']);
      let start = hasStart ? data.employmentStartDate : '';
      let end = hasEnd ? data.employmentEndDate : '';
      let today = currentKoreaDate();
      return validEmploymentPeriod(data)
        && (!hasStart || start <= today)
        && (!hasEnd || today <= end);
    }

    function activeAccess() {
      return signedIn()
        && exists(accessPath())
        && employmentPeriodIsActive(get(accessPath()).data);
    }

    function isCoach() {
      return activeAccess() && (
        get(accessPath()).data.role == 'coach'
        || (get(accessPath()).data.keys().hasAny(['coachDepartment'])
          && get(accessPath()).data.coachDepartment is string)
      );
    }

    function isExternalInstructor() {
      return activeAccess() && (
        get(accessPath()).data.role == 'external'
        || (get(accessPath()).data.keys().hasAny(['externalCourse'])
          && get(accessPath()).data.externalCourse is string)
        || (get(accessPath()).data.keys().hasAny(['externalClasses'])
          && get(accessPath()).data.externalClasses is list
          && get(accessPath()).data.externalClasses.size() > 0)
      );
    }

    function isHomeroomTeacher() {
      return isTeacher() && exists(accessPath()) && get(accessPath()).data.role == 'teacher';
    }

    function ownsClass(data) {
      return isHomeroomTeacher()
        && data.grade == get(accessPath()).data.grade
        && data.classNo == get(accessPath()).data.classNo;
    }

    function ownsAttendance(data) {
      return isHomeroomTeacher()
        && data.grade == get(accessPath()).data.grade
        && data.classNo == get(accessPath()).data.classNo;
    }

    function canUpdateAttendance(previous, proposed) {
      let registeredTeacher = signedIn()
        && email().matches('.*@nsworld[.]net$')
        && exists(accessPath());
      let account = registeredTeacher ? get(accessPath()).data : {};
      return registeredTeacher
        && account.role == 'teacher'
        && employmentPeriodIsActive(account)
        && previous.grade == account.grade
        && previous.classNo == account.classNo
        && proposed.grade == account.grade
        && proposed.classNo == account.classNo
        && proposed.studentId == previous.studentId
        && proposed.date == previous.date
        && proposed.departments == previous.departments;
    }

    // Evaluate access-period validation once per attendance read, including
    // accounts that have more than one teaching role.
    function canReadAttendance(data) {
      let registered = signedIn() && exists(accessPath());
      let account = registered ? get(accessPath()).data : {};
      let role = account.get('role', '');
      let department = role == 'coach' ? account.get('department', '') : account.get('coachDepartment', '');
      return signedIn() && (email() == 'leens@nsworld.net'
        || (registered && employmentPeriodIsActive(account) && (
          role == 'admin'
          || (role == 'teacher' && email().matches('.*@nsworld[.]net$')
            && data.grade == account.get('grade', '') && data.classNo == account.get('classNo', ''))
          || role == 'external' || account.get('externalCourse', null) is string
          || (account.get('externalClasses', []) is list && account.get('externalClasses', []).size() > 0)
          || ((role == 'coach' || account.get('coachDepartment', null) is string) && department in data.departments)
        )));
    }

    function validStudent(data) {
      return data.keys().hasOnly(['name', 'grade', 'classNo', 'number', 'departments'])
        && data.name is string
        && data.grade is string
        && data.classNo is string
        && data.number is string
        && data.departments is list
        && data.departments.size() > 0;
    }

    function validAttendance(data) {
      return data.keys().hasOnly(['studentId', 'date', 'grade', 'classNo', 'departments', 'status', 'memo', 'updatedBy', 'updatedAt'])
        && data.studentId is string
        && data.date is string
        && data.grade is string
        && data.classNo is string
        && data.departments is list
        && data.departments.size() > 0
        && data.status in ['present', 'absent', 'late', 'early', 'unset']
        && data.memo is string
        && data.updatedBy == email();
    }

    function coachDepartment() {
      return get(accessPath()).data.role == 'coach'
        ? get(accessPath()).data.department
        : get(accessPath()).data.coachDepartment;
    }

    function canReadAsExternalInstructor() {
      return isExternalInstructor();
    }

    function validAccess(accountEmail, data) {
      return data.role in ['admin', 'teacher', 'coach', 'external']
        && data.updatedBy == email()
        && validEmploymentPeriod(data)
        && (!data.keys().hasAny(['coachDepartment']) || data.coachDepartment is string)
        && (!data.keys().hasAny(['externalClasses']) || data.externalClasses is list)
        && (!data.keys().hasAny(['externalCourse']) || data.externalCourse is string)
        && (!data.keys().hasAny(['employmentStartDate']) || data.employmentStartDate is string)
        && (!data.keys().hasAny(['employmentEndDate']) || data.employmentEndDate is string)
        && (
          (data.role == 'admin' && accountEmail.matches('.*@nsworld[.]net$'))
          || (data.role == 'teacher'
            && accountEmail.matches('.*@nsworld[.]net$')
            && data.grade is string
            && data.classNo is string)
          || (data.role == 'coach'
            && data.department is string)
          || data.role == 'external'
        );
    }

    match /settings/public {
      allow read: if isRegisteredAccount();
      allow write: if isAdmin();
    }

    match /access/{accountEmail} {
      allow read: if isAdmin() || (signedIn() && accountEmail == email());
      allow create, update: if isAdmin()
        && (accountEmail != 'leens@nsworld.net' || request.resource.data.role == 'admin')
        && validAccess(accountEmail, request.resource.data);
      allow delete: if isAdmin() && accountEmail != 'leens@nsworld.net';
    }

    match /students/{studentId} {
      allow read: if isAdmin() || ownsClass(resource.data) || canReadAsExternalInstructor() || (isCoach() && coachDepartment() in resource.data.departments);
      allow create: if validStudent(request.resource.data) && (isAdmin() || ownsClass(request.resource.data));
      allow update: if validStudent(request.resource.data) && (isAdmin() || (ownsClass(resource.data) && ownsClass(request.resource.data)));
      allow delete: if isAdmin() || ownsClass(resource.data);
    }

    match /contacts/{studentId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /privacyAcknowledgements/{accountEmail} {
      allow read: if isAdmin() || (isRegisteredAccount() && accountEmail == email());
      allow create, update: if isRegisteredAccount()
        && accountEmail == email()
        && request.resource.data.keys().hasOnly(['email', 'uid', 'policyVersion', 'accepted', 'acceptedAt'])
        && request.resource.data.email == email()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.policyVersion == '2026-08-09-r3'
        && request.resource.data.accepted == true
        && request.resource.data.acceptedAt == request.time;
      allow delete: if isAdmin() || (signedIn() && accountEmail == email());
    }

    match /attendance/{recordId} {
      allow read: if canReadAttendance(resource.data);
      allow create: if validAttendance(request.resource.data)
        && (isAdmin() || (ownsAttendance(request.resource.data)
          && recordId == request.resource.data.date + '_' + request.resource.data.studentId
          && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
          && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.grade == request.resource.data.grade
          && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.classNo == request.resource.data.classNo
          && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.departments == request.resource.data.departments));
      allow update: if validAttendance(request.resource.data)
        && (isAdmin() || canUpdateAttendance(resource.data, request.resource.data));
      allow delete: if isAdmin() || ownsAttendance(resource.data);
    }

    match /notificationTokens/{tokenId} {
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['token', 'uid', 'email', 'role', 'audiences', 'language', 'active', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && request.resource.data.token is string
        && request.resource.data.audiences is list
        && request.resource.data.language in ['ko', 'en', 'fr', 'es']
        && request.resource.data.active == true
        && (
          (request.resource.data.role == 'admin' && isAdmin()
            && (
              (isCoach() && request.resource.data.audiences == ['input', 'review', 'admin-usage', 'coach-review'])
              || (!isCoach() && request.resource.data.audiences == ['input', 'review', 'admin-usage'])
            ))
          || (request.resource.data.role == 'teacher' && isHomeroomTeacher()
            && (
              (isCoach() && request.resource.data.audiences == ['input', 'review', 'coach-review'])
              || (!isCoach() && request.resource.data.audiences == ['input', 'review'])
            ))
          || (request.resource.data.role == 'coach' && isCoach()
            && request.resource.data.audiences == ['coach-review'])
        );
      allow read, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /notificationRequests/{requestId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['type', 'targetEmail', 'grade', 'classNo', 'title', 'body', 'status', 'requestedBy', 'requestedAt'])
        && request.resource.data.type == 'unset-reminder'
        && request.resource.data.targetEmail.matches('.*@nsworld[.]net$')
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == email();
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
